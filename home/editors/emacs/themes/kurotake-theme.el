;;; kurotake-theme.el --- Kurotake color theme -*- lexical-binding: t; -*-

;; Port of the VS Code "kurotake" theme. Palette and token colors taken from
;; home/editors/themes/kurotake/themes/kurotake-color-theme.json.

(deftheme kurotake "Kurotake, a dark green theme ported from VS Code.")

(let ((class '((class color) (min-colors 89))))
  (custom-theme-set-faces
   'kurotake
   ;; Base
   `(default ((,class (:background "#0d0d0d" :foreground "#f5f5f5"))))
   `(cursor ((,class (:background "#7db46c"))))
   `(region ((,class (:background "#4a4a4a"))))
   `(secondary-selection ((,class (:background "#2d2d2d"))))
   `(highlight ((,class (:background "#3a3a3a"))))
   `(hl-line ((,class (:background "#1a1a1a"))))
   `(shadow ((,class (:foreground "#5f615f"))))
   `(fringe ((,class (:background "#0d0d0d" :foreground "#4a4a4a"))))
   `(vertical-border ((,class (:foreground "#3a3a3a"))))
   `(window-divider ((,class (:foreground "#3a3a3a"))))
   `(window-divider-first-pixel ((,class (:foreground "#3a3a3a"))))
   `(window-divider-last-pixel ((,class (:foreground "#3a3a3a"))))
   `(scroll-bar ((,class (:background "#2d2d2d"))))
   `(tooltip ((,class (:background "#2d2d2d" :foreground "#f5f5f5"))))
   `(button ((,class (:foreground "#90ee90" :underline t))))
   `(link ((,class (:foreground "#90ee90" :underline t))))
   `(link-visited ((,class (:foreground "#8fbc8f" :underline t))))
   `(error ((,class (:foreground "#d2691e"))))
   `(warning ((,class (:foreground "#daa520"))))
   `(success ((,class (:foreground "#7db46c"))))

   ;; Chrome
   `(mode-line ((,class (:background "#1a1a1a" :foreground "#7db46c" :box nil))))
   `(mode-line-inactive ((,class (:background "#1a1a1a" :foreground "#5f615f" :box nil))))
   `(mode-line-buffer-id ((,class (:foreground "#98fb98" :weight bold))))
   `(mode-line-emphasis ((,class (:foreground "#90ee90"))))
   `(mode-line-highlight ((,class (:foreground "#f5f5f5"))))
   `(header-line ((,class (:background "#1a1a1a" :foreground "#8fbc8f" :box nil))))
   `(minibuffer-prompt ((,class (:foreground "#7db46c" :weight bold))))
   `(line-number ((,class (:background "#0d0d0d" :foreground "#89a288"))))
   `(line-number-current-line ((,class (:background "#0d0d0d" :foreground "#8fbc8f"))))
   `(tab-bar ((,class (:background "#1a1a1a" :foreground "#5f615f"))))
   `(tab-bar-tab ((,class (:background "#0d0d0d" :foreground "#f5f5f5"))))
   `(tab-bar-tab-inactive ((,class (:background "#1a1a1a" :foreground "#5f615f"))))

   ;; Search and matching
   `(isearch ((,class (:background "#7db46c" :foreground "#0d0d0d"))))
   `(isearch-fail ((,class (:background "#d2691e" :foreground "#0d0d0d"))))
   `(lazy-highlight ((,class (:background "#3a3a3a" :foreground "#98fb98"))))
   `(match ((,class (:background "#3a3a3a" :foreground "#98fb98"))))
   `(show-paren-match ((,class (:foreground "#98fb98" :weight bold))))
   `(show-paren-mismatch ((,class (:background "#d2691e" :foreground "#0d0d0d"))))
   `(trailing-whitespace ((,class (:background "#d2691e"))))
   `(whitespace-space ((,class (:foreground "#333333"))))
   `(whitespace-tab ((,class (:foreground "#333333"))))
   `(whitespace-newline ((,class (:foreground "#333333"))))

   ;; Font lock
   `(font-lock-comment-face ((,class (:foreground "#4da941" :slant italic))))
   `(font-lock-comment-delimiter-face ((,class (:foreground "#4da941" :slant italic))))
   `(font-lock-string-face ((,class (:foreground "#90ee90"))))
   `(font-lock-doc-face ((,class (:foreground "#90ee90" :slant italic))))
   `(font-lock-keyword-face ((,class (:foreground "#8fbc8f"))))
   `(font-lock-builtin-face ((,class (:foreground "#deb887"))))
   `(font-lock-function-name-face ((,class (:foreground "#7db46c"))))
   `(font-lock-variable-name-face ((,class (:foreground "#f5f5f5"))))
   `(font-lock-type-face ((,class (:foreground "#8fbc8f"))))
   `(font-lock-constant-face ((,class (:foreground "#daa520"))))
   `(font-lock-number-face ((,class (:foreground "#daa520"))))
   `(font-lock-operator-face ((,class (:foreground "#cd853f"))))
   `(font-lock-preprocessor-face ((,class (:foreground "#cd853f"))))
   `(font-lock-negation-char-face ((,class (:foreground "#d2691e"))))
   `(font-lock-warning-face ((,class (:foreground "#d2691e" :weight bold))))
   `(font-lock-regexp-grouping-backslash ((,class (:foreground "#cd853f"))))
   `(font-lock-regexp-grouping-construct ((,class (:foreground "#deb887"))))

   ;; Completion
   `(completions-common-part ((,class (:foreground "#98fb98" :weight bold))))
   `(completions-first-difference ((,class (:foreground "#deb887"))))
   `(vertico-current ((,class (:background "#3a3a3a" :foreground "#8fbc8f"))))
   `(vertico-group-title ((,class (:foreground "#7db46c" :weight bold))))
   `(vertico-group-separator ((,class (:foreground "#4a4a4a"))))
   `(marginalia-documentation ((,class (:foreground "#89a288"))))
   `(marginalia-file-name ((,class (:foreground "#f5f5f5"))))
   `(marginalia-size ((,class (:foreground "#89a288"))))
   `(marginalia-date ((,class (:foreground "#89a288"))))
   `(marginalia-mode ((,class (:foreground "#deb887"))))
   `(marginalia-type ((,class (:foreground "#8fbc8f"))))

   ;; Org
   `(org-level-1 ((,class (:foreground "#7db46c" :weight bold))))
   `(org-level-2 ((,class (:foreground "#8fbc8f" :weight bold))))
   `(org-level-3 ((,class (:foreground "#90ee90" :weight bold))))
   `(org-level-4 ((,class (:foreground "#deb887" :weight bold))))
   `(org-level-5 ((,class (:foreground "#cd853f" :weight bold))))
   `(org-level-6 ((,class (:foreground "#daa520" :weight bold))))
   `(org-level-7 ((,class (:foreground "#98fb98" :weight bold))))
   `(org-level-8 ((,class (:foreground "#89a288" :weight bold))))
   `(org-document-title ((,class (:foreground "#f5f5f5" :weight bold :height 1.2))))
   `(org-document-info ((,class (:foreground "#89a288"))))
   `(org-todo ((,class (:foreground "#d2691e" :weight bold))))
   `(org-done ((,class (:foreground "#7db46c" :weight bold))))
   `(org-headline-done ((,class (:foreground "#89a288"))))
   `(org-block ((,class (:background "#1a1a1a" :extend t))))
   `(org-block-begin-line ((,class (:background "#1a1a1a" :foreground "#5f615f" :slant italic :extend t))))
   `(org-block-end-line ((,class (:background "#1a1a1a" :foreground "#5f615f" :slant italic :extend t))))
   `(org-code ((,class (:background "#1a1a1a" :foreground "#daa520"))))
   `(org-verbatim ((,class (:background "#1a1a1a" :foreground "#90ee90"))))
   `(org-link ((,class (:foreground "#90ee90" :underline t))))
   `(org-date ((,class (:foreground "#deb887" :underline t))))
   `(org-special-keyword ((,class (:foreground "#cd853f"))))
   `(org-property-value ((,class (:foreground "#f5f5f5"))))
   `(org-tag ((,class (:foreground "#8fbc8f"))))
   `(org-priority ((,class (:foreground "#d2691e"))))
   `(org-checkbox ((,class (:foreground "#7db46c"))))
   `(org-table ((,class (:foreground "#f5f5f5"))))
   `(org-formula ((,class (:foreground "#daa520"))))
   `(org-agenda-date ((,class (:foreground "#7db46c" :weight bold))))
   `(org-agenda-date-today ((,class (:foreground "#98fb98" :weight bold :underline t))))
   `(org-agenda-date-weekend ((,class (:foreground "#89a288"))))
   `(org-agenda-structure ((,class (:foreground "#8fbc8f" :weight bold))))
   `(org-agenda-done ((,class (:foreground "#5f615f"))))
   `(org-scheduled ((,class (:foreground "#7db46c"))))
   `(org-scheduled-today ((,class (:foreground "#98fb98"))))
   `(org-deadline-warning ((,class (:foreground "#d2691e" :weight bold))))
   `(org-upcoming-deadline ((,class (:foreground "#daa520"))))

   ;; Magit
   `(magit-section-heading ((,class (:foreground "#7db46c" :weight bold))))
   `(magit-section-highlight ((,class (:background "#1a1a1a"))))
   `(magit-branch-local ((,class (:foreground "#90ee90"))))
   `(magit-branch-remote ((,class (:foreground "#8fbc8f"))))
   `(magit-tag ((,class (:foreground "#daa520"))))
   `(magit-hash ((,class (:foreground "#89a288"))))
   `(magit-log-author ((,class (:foreground "#deb887"))))
   `(magit-log-date ((,class (:foreground "#89a288"))))
   `(magit-diff-file-heading ((,class (:foreground "#f5f5f5" :weight bold))))
   `(magit-diff-hunk-heading ((,class (:background "#2d2d2d" :foreground "#8fbc8f"))))
   `(magit-diff-hunk-heading-highlight ((,class (:background "#3a3a3a" :foreground "#98fb98"))))
   `(magit-diff-added ((,class (:foreground "#7db46c"))))
   `(magit-diff-added-highlight ((,class (:background "#1a2b1a" :foreground "#98fb98"))))
   `(magit-diff-removed ((,class (:foreground "#d2691e"))))
   `(magit-diff-removed-highlight ((,class (:background "#2b1a1a" :foreground "#ff7f50"))))
   `(magit-diff-context ((,class (:foreground "#89a288"))))
   `(magit-diff-context-highlight ((,class (:background "#1a1a1a" :foreground "#f5f5f5"))))
   `(magit-process-ok ((,class (:foreground "#7db46c"))))
   `(magit-process-ng ((,class (:foreground "#d2691e"))))
   `(magit-signature-good ((,class (:foreground "#7db46c"))))
   `(magit-signature-bad ((,class (:foreground "#d2691e"))))
   `(magit-signature-untrusted ((,class (:foreground "#daa520"))))

   ;; Diff (used by magit and vc)
   `(diff-added ((,class (:foreground "#7db46c"))))
   `(diff-removed ((,class (:foreground "#d2691e"))))
   `(diff-changed ((,class (:foreground "#daa520"))))
   `(diff-header ((,class (:foreground "#89a288"))))
   `(diff-file-header ((,class (:foreground "#f5f5f5" :weight bold))))

   ;; Dired
   `(dired-directory ((,class (:foreground "#7db46c"))))
   `(dired-marked ((,class (:foreground "#daa520"))))
   `(dired-symlink ((,class (:foreground "#90ee90" :slant italic))))
   `(dired-ignored ((,class (:foreground "#5f615f"))))

   ;; Diagnostics
   `(flymake-error ((,class (:underline (:style wave :color "#d2691e")))))
   `(flymake-warning ((,class (:underline (:style wave :color "#daa520")))))
   `(flymake-note ((,class (:underline (:style wave :color "#8fbc8f")))))
   `(flyspell-incorrect ((,class (:underline (:style wave :color "#d2691e")))))
   `(flyspell-duplicate ((,class (:underline (:style wave :color "#daa520")))))

   ;; Commit messages
   `(git-commit-summary ((,class (:foreground "#98fb98"))))
   `(git-commit-overlong-summary ((,class (:foreground "#d2691e"))))
   `(git-commit-nonempty-second-line ((,class (:foreground "#daa520"))))

   ;; Shell
   `(eshell-prompt ((,class (:foreground "#7db46c" :weight bold))))))

(provide-theme 'kurotake)

;;; kurotake-theme.el ends here

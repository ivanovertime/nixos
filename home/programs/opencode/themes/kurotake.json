{
  "base": {
    "categorical": ["green", "yellow", "orange", "cyan"],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "faint": "$hue.neutral.500",
      "action": {
        "primary": {
          "base": "$hue.green.400",
          "$hovered": "$hue.green.300",
          "$focused": "$hue.green.300",
          "$pressed": "$hue.green.500",
          "$selected": "$hue.green.600",
          "$disabled": "$hue.neutral.500"
        },
        "secondary": {
          "base": "$hue.neutral.400",
          "$hovered": "$hue.neutral.200",
          "$focused": "$hue.neutral.200",
          "$pressed": "$hue.neutral.300",
          "$selected": "$hue.neutral.300",
          "$disabled": "$hue.neutral.500"
        },
        "destructive": {
          "base": "$hue.red.400",
          "$hovered": "$hue.red.300",
          "$focused": "$hue.red.300",
          "$pressed": "$hue.red.500",
          "$selected": "$hue.red.600",
          "$disabled": "$hue.neutral.500"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.green.300",
        "$focused": "$hue.green.300",
        "$pressed": "$hue.green.400",
        "$selected": "$hue.green.500",
        "$disabled": "$hue.neutral.500"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.400",
          "muted": "$hue.red.500"
        },
        "warning": {
          "base": "$hue.yellow.400",
          "muted": "$hue.yellow.500"
        },
        "success": {
          "base": "$hue.green.300",
          "muted": "$hue.green.500"
        },
        "info": {
          "base": "$hue.cyan.300",
          "muted": "$hue.cyan.500"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.900",
      "raised": {
        "base": "$hue.neutral.800",
        "high": "#2d2d2d",
        "max": "$hue.neutral.700"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$background.raised.high",
          "$focused": "$hue.green.600",
          "$pressed": "$hue.neutral.700",
          "$selected": "transparent",
          "$disabled": "transparent"
        },
        "secondary": {
          "base": "transparent",
          "$hovered": "$background.raised.high",
          "$focused": "$hue.neutral.700",
          "$pressed": "$hue.neutral.700",
          "$selected": "transparent",
          "$disabled": "transparent"
        },
        "destructive": {
          "base": "$hue.red.600",
          "$hovered": "$hue.red.500",
          "$focused": "$hue.red.500",
          "$pressed": "$hue.red.700",
          "$selected": "$hue.red.700",
          "$disabled": "$hue.neutral.700"
        }
      },
      "formfield": {
        "base": "#2d2d2d",
        "$hovered": "$background.raised.max",
        "$focused": "#2d2d2d",
        "$pressed": "$background.raised.base",
        "$selected": "#2d2d2d",
        "$disabled": "$background.raised.base"
      },
      "feedback": {
        "error": {
          "base": "#2a130a"
        },
        "warning": {
          "base": "#262006"
        },
        "success": {
          "base": "#10230d"
        },
        "info": {
          "base": "#0e2023"
        }
      }
    },
    "border": {
      "base": "$hue.neutral.700"
    },
    "scrollbar": {
      "base": "$hue.neutral.500"
    },
    "diff": {
      "text": {
        "added": "$hue.green.300",
        "removed": "$hue.red.400",
        "context": "$hue.neutral.400",
        "hunkHeader": "#8fbc8f"
      },
      "background": {
        "added": "#10230d",
        "removed": "#2a130a",
        "context": "$background.raised.base"
      },
      "highlight": {
        "added": "#1d3a17",
        "removed": "#43200f"
      },
      "lineNumber": {
        "text": "$hue.neutral.500",
        "background": {
          "added": "#0b1808",
          "removed": "#1c0d06"
        }
      }
    },
    "syntax": {
      "comment": "#4da941",
      "keyword": "#8fbc8f",
      "function": "$hue.green.400",
      "variable": "$hue.neutral.200",
      "string": "$hue.green.300",
      "number": "$hue.yellow.400",
      "type": "#6b8e23",
      "operator": "$hue.orange.400",
      "punctuation": "$hue.neutral.400"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "#ffffff",
      "link": "$hue.green.400",
      "linkText": "#8fbc8f",
      "code": "$hue.green.300",
      "blockQuote": "$hue.neutral.400",
      "emphasis": "#deb887",
      "strong": "$hue.green.400",
      "horizontalRule": "$hue.neutral.700",
      "listItem": "$hue.green.400",
      "listEnumeration": "$hue.yellow.400",
      "image": "$hue.cyan.300",
      "imageText": "$hue.neutral.400",
      "codeBlock": "$hue.green.300"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
